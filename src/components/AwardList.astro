---
import MaybeLink from '~/components/MaybeLink.astro';
import type { Award } from '~/lib/content';

interface Props {
  awards: { award: Award; game: string | null }[];
}

const { awards } = Astro.props;
---

<ul role="list" class="awards">
  {
    awards.map(({ award, game }) => (
      <li class="award">
        <p class="label award__result">{award.result}</p>
        <p class="award__category">{award.category}</p>
        <p class="award__event">
          {award.url ? <a href={award.url}>{award.event}</a> : award.event}
          {game && <span> · {game}</span>}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .awards {
    display: grid;
    gap: var(--space-6);
    margin: 0;
  }

  .award {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-accent);
  }

  .award__result {
    color: var(--color-accent);
  }

  .award__category {
    font-family: var(--font-display);
    font-size: var(--text-display-s);
    line-height: 1.05;
  }

  .award__event {
    color: var(--color-muted);
  }
</style>

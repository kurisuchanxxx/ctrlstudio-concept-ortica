---
import { CONCEPT, CONCEPT_MODE } from '~/config/concept.mjs';
import ContactValue from '~/components/ContactValue.astro';
import MaybeLink from '~/components/MaybeLink.astro';
import { useTranslations } from '~/i18n';
import { Image } from 'astro:assets';
import { buildNow, getStudio } from '~/lib/content';
import { url } from '~/lib/url';

const t = useTranslations(Astro.currentLocale);
const studio = await getStudio();
const consolePublisher = studio.publishers.find((p) => p.role.toLowerCase().includes('console'));
---

<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div class="brand">
        {
          studio.assets.logo && (
            <Image class="logo" src={studio.assets.logo.src} width={72} height={72} densities={[1, 2]} alt="" />
          )
        }
        <a class="wordmark" href={url()}>{studio.name}</a>
        <p class="muted">{studio.location.city}, {studio.location.country}</p>
      </div>

      <div>
        <h2 class="label">{t('footer.follow')}</h2>
        <ul role="list" class="list">
          {
            studio.channels.map((c) => (
              <li>
                <MaybeLink href={c.url}>{c.label}</MaybeLink>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="stack">
        <div>
          <h2 class="label">{t('footer.press')}</h2>
          <p><ContactValue email={studio.contacts.press} /></p>
        </div>
        <div>
          <h2 class="label">{t('footer.business')}</h2>
          <p><ContactValue email={studio.contacts.business} /></p>
        </div>
        <div>
          <a class="press-link" href={url('press/')}>{t('footer.pressKit')}</a>
        </div>
      </div>

      {
        consolePublisher && (
          <div>
            <h2 class="label">{t('footer.publisher')}</h2>
            <p>
              <MaybeLink href={consolePublisher.url}>{consolePublisher.name}</MaybeLink>
            </p>
            <p class="muted">
              {consolePublisher.city}, {consolePublisher.country}
            </p>
          </div>
        )
      }
    </div>

    <div class="base">
      {
        CONCEPT_MODE ? (
          <p class="concept-note">
            {t('concept.footer')} <a href={CONCEPT.authorUrl}>{CONCEPT.authorUrlLabel}</a>
          </p>
        ) : (
          <p class="muted">{t('footer.rights', { year: buildNow().getUTCFullYear() })}</p>
        )
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-9) var(--space-6);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-7) var(--space-6);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    text-decoration: none;
  }

  .logo {
    width: 72px;
    height: 72px;
    margin-bottom: var(--space-4);
  }

  .brand p {
    margin-top: var(--space-3);
  }

  .label {
    margin-bottom: var(--space-3);
  }

  .list {
    display: grid;
    gap: var(--space-2);
  }

  .stack {
    display: grid;
    gap: var(--space-5);
  }

  .muted {
    color: var(--color-muted);
  }

  .press-link {
    font-weight: 600;
  }

  .base {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .concept-note {
    max-width: 70ch;
  }
</style>

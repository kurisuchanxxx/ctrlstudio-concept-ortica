---
// Studio press kit, modelled on presskit(): fact sheet, descriptions,
// games with their own kits, logos and photos, recognition, contact.
import Base from '~/layouts/Base.astro';
import AwardList from '~/components/AwardList.astro';
import ContactValue from '~/components/ContactValue.astro';
import MaybeLink from '~/components/MaybeLink.astro';
import PressQuotes from '~/components/PressQuotes.astro';
import AssetTile from '~/components/press/AssetTile.astro';
import PressDownload from '~/components/press/PressDownload.astro';
import { entryLabel, platformDate } from '~/components/labels';
import { useTranslations } from '~/i18n';
import { getGames, getPressQuotes, getStudio } from '~/lib/content';

const [studio, games, quotes] = await Promise.all([getStudio(), getGames(), getPressQuotes()]);
const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale;
const awards = games.flatMap((g) => g.awards.map((award) => ({ award, game: g.title })));
const rolesKnown = studio.team.some((m) => m.role);
---

<Base title={t('press.title')} description={studio.shortDescription}>
  <div class="container page">
    <header class="intro">
      <p class="label">{studio.name}</p>
      <h1 class="title">{t('press.title')}</h1>
      <p class="lead">{t('press.intro')}</p>
      <div class="btn-row">
        <PressDownload href={studio.pressKitUrl} />
      </div>
    </header>

    <div class="cols">
      <section aria-labelledby="factsheet-title">
        <h2 id="factsheet-title" class="label heading">{t('press.factsheet')}</h2>
        <dl class="facts">
          <div class="row">
            <dt class="label">{t('facts.developer')}</dt>
            <dd>{studio.name}</dd>
          </div>
          <div class="row">
            <dt class="label">{t('facts.basedIn')}</dt>
            <dd>{studio.location.city}, {studio.location.country}</dd>
          </div>
          <div class="row">
            <dt class="label">{t('facts.founded')}</dt>
            <dd>{studio.founded}</dd>
          </div>
          <div class="row">
            <dt class="label">{t('facts.team')}</dt>
            <dd>
              <ul role="list" class="plain">
                {
                  studio.team.map((m) => (
                    <li>
                      {m.url ? <a href={m.url}>{m.name}</a> : m.name}
                      {m.role && <span class="muted"> · {m.role}</span>}
                    </li>
                  ))
                }
              </ul>
              {!rolesKnown && <span class="pending roles">{t('facts.roles')} · {t('pending.label')}</span>}
            </dd>
          </div>
          {
            studio.engine && (
              <div class="row">
                <dt class="label">{t('facts.engine')}</dt>
                <dd>{studio.engine}</dd>
              </div>
            )
          }
          {
            studio.publishers.map((p) => (
              <div class="row">
                <dt class="label">{p.role}</dt>
                <dd>
                  <MaybeLink href={p.url}>{p.name}</MaybeLink>
                  <span class="muted">
                    {' '}
                    · {p.city}, {p.country}
                  </span>
                </dd>
              </div>
            ))
          }
          <div class="row">
            <dt class="label">{t('facts.pressContact')}</dt>
            <dd><ContactValue email={studio.contacts.press} /></dd>
          </div>
          <div class="row">
            <dt class="label">{t('facts.businessContact')}</dt>
            <dd><ContactValue email={studio.contacts.business} /></dd>
          </div>
          <div class="row">
            <dt class="label">{t('facts.channels')}</dt>
            <dd>
              <ul role="list" class="plain">
                {
                  studio.channels.map((c) => (
                    <li>
                      <MaybeLink href={c.url}>{c.label}</MaybeLink>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
        </dl>
      </section>

      <div class="texts">
        <section aria-labelledby="short-title">
          <h2 id="short-title" class="label heading">{t('press.shortDescription')}</h2>
          <p class="short">{studio.shortDescription}</p>
        </section>
        <section aria-labelledby="long-title">
          <h2 id="long-title" class="label heading">{t('press.longDescription')}</h2>
          <div class="prose">
            {studio.longDescription.map((p) => <p>{p}</p>)}
          </div>
        </section>
      </div>
    </div>

    <section aria-labelledby="games-title" class="block">
      <h2 id="games-title" class="label heading">{t('press.games')}</h2>
      <ul role="list" class="games">
        {
          games.map((g) => (
            <li class="game">
              <p class="label">{entryLabel(t, g)}</p>
              <h3 class="game__title">
                <a href={g.pressHref}>{g.title}</a>
              </h3>
              <p class="muted">{g.shortDescription}</p>
              <ul role="list" class="plain small">
                {g.platforms.map((p) => (
                  <li>
                    {p.name} <span class="muted">· {platformDate(t, p, locale)}</span>
                  </li>
                ))}
              </ul>
              <p class="links">
                <a href={g.pressHref}>{t('cta.pressKit')}</a>
                <a href={g.href}>{t('cta.aboutGame')}</a>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="logos-title" class="block">
      <h2 id="logos-title" class="label heading">{t('press.logos')}</h2>
      <div class="tiles">
        <AssetTile
          asset={studio.assets.logo}
          label={t('slot.logo')}
          alt={`${studio.name} logo`}
          ratio="3/2"
          contain
        />
        <AssetTile asset={studio.assets.team} label={t('slot.teamPhoto')} alt={`${studio.name} team`} ratio="3/2" />
      </div>
    </section>

    {
      awards.length > 0 && (
        <section aria-labelledby="awards-title" class="block">
          <h2 id="awards-title" class="label heading">
            {t('press.awards')}
          </h2>
          <AwardList awards={awards} />
        </section>
      )
    }

    <section aria-labelledby="quotes-title" class="block">
      <h2 id="quotes-title" class="label heading">{t('press.quotes')}</h2>
      <PressQuotes quotes={quotes} slots={3} />
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: calc(var(--space-10) + var(--space-5));
    padding-bottom: var(--space-10);
    display: grid;
    gap: var(--space-9);
  }

  .intro {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
  }

  .title {
    font-size: var(--text-display-l);
    line-height: 0.92;
  }

  .lead {
    font-size: var(--text-lg);
    max-width: 52ch;
  }

  .heading {
    margin-bottom: var(--space-5);
  }

  .cols {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .cols {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-9);
    }
  }

  .facts {
    border-top: 1px solid var(--color-line);
  }

  .row {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  .plain {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .small {
    font-size: var(--text-sm);
  }

  .roles {
    margin-top: var(--space-3);
  }

  .muted {
    color: var(--color-muted);
  }

  .texts {
    display: grid;
    gap: var(--space-8);
    align-content: start;
  }

  .short {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  .games {
    display: grid;
    gap: var(--space-7);
    margin: 0;
  }

  @media (min-width: 48rem) {
    .games {
      grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    }
  }

  .game {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line-strong);
  }

  .game__title {
    font-size: var(--text-display-s);
  }

  .game__title a {
    text-decoration: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .tiles {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .tiles {
      grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    }
  }
</style>

---
// One template for every game. Adding a game needs only a content file and
// an asset folder: see CLAUDE.md, "Add a game".
import Base from '~/layouts/Base.astro';
import GameFacts from '~/components/game/GameFacts.astro';
import GameHero from '~/components/game/GameHero.astro';
import Gallery from '~/components/game/Gallery.astro';
import TrailerFacade from '~/components/game/TrailerFacade.astro';
import { entryLabel, stateLabel } from '~/components/labels';
import { useTranslations } from '~/i18n';
import { getGames, getStudio, type Game } from '~/lib/content';

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
const [studio, games] = await Promise.all([getStudio(), getGames()]);
const others = games.filter((g) => g.slug !== game.slug);
const t = useTranslations(Astro.currentLocale);
---

<Base title={game.title} description={game.shortDescription} palette={game.palette} ogImage={game.assets.keyArt}>
  <GameHero game={game} />

  <div class="container body">
    <section class="about" aria-labelledby="about-title" data-reveal>
      <h2 id="about-title" class="label">{t('game.description')}</h2>
      <div class="prose description">
        {game.description.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="facts" aria-labelledby="facts-title" data-reveal>
      <h2 id="facts-title" class="label">{t('facts.title')}</h2>
      <GameFacts game={game} studio={studio} />
    </section>
  </div>

  <div class="container stack">
    <div data-reveal><TrailerFacade game={game} /></div>
    <div data-reveal><Gallery game={game} /></div>

    {
      game.contentWarnings.length > 0 && (
        <section class="cw" aria-labelledby="cw-title" data-reveal>
          <h2 id="cw-title" class="label">
            {t('game.contentWarning')}
          </h2>
          <ul role="list">
            {game.contentWarnings.map((w) => (
              <li>{w}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="press" aria-labelledby="press-title" data-reveal>
      <div>
        <h2 id="press-title" class="press__title">{t('game.pressKit', { title: game.title })}</h2>
        <p class="muted">{t('game.pressKitText')}</p>
      </div>
      <a class="btn btn--ghost" href={game.pressHref}>{t('cta.pressKit')}</a>
    </section>

    {
      others.length > 0 && (
        <nav class="more" aria-labelledby="more-title">
          <h2 id="more-title" class="label">
            {t('game.more')}
          </h2>
          <ul role="list">
            {others.map((g) => (
              <li>
                <a href={g.href}>
                  <span class="label">
                    {entryLabel(t, g)} · {stateLabel(t, g, Astro.currentLocale)}
                  </span>
                  <span class="more__title">{g.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>

<style>
  .body {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-9);
  }

  @media (min-width: 64rem) {
    .body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-9);
    }
  }

  .about,
  .facts {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .description {
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .stack {
    display: grid;
    gap: var(--space-9);
    padding-bottom: var(--space-10);
  }

  .cw {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-line-strong);
  }

  .cw ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .cw li::before {
    content: '';
    display: inline-block;
    width: 0.75em;
    height: 1px;
    margin-right: 0.6em;
    vertical-align: middle;
    background: var(--color-muted);
  }

  .press {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-line);
  }

  .press__title {
    font-size: var(--text-display-s);
    margin-bottom: var(--space-3);
  }

  .muted {
    color: var(--color-muted);
  }

  .more ul {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
  }

  @media (min-width: 40rem) {
    .more ul {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }

  .more a {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line-strong);
    text-decoration: none;
  }

  .more__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.1;
  }
</style>
